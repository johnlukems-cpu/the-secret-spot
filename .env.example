# ---------------------------------------------------------------
# THE SECRET SPOT – environment variables (placeholders only)
# Copy to .env.local for development. Never commit real values.
# ---------------------------------------------------------------

# Public (exposed to the browser)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Optional analytics – only loaded after visitor consent
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# Server-only secrets (NEVER prefix with NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
CRON_SECRET=generate-a-long-random-string
IP_HASH_SALT=generate-another-random-string

# E-mail (Resend). Leave empty to disable – notifications are then marked "not configured".
RESEND_API_KEY=
EMAIL_FROM="THE SECRET SPOT <bestellingen@your-domain.sr>"

# WhatsApp Business Cloud API (Meta). Leave empty to disable.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v21.0

# Tests only
DB_SUPERUSER_URL=postgres://postgres:postgres@localhost:5432/postgres
E2E_BASE_URL=http://localhost:3000
E2E_LIVE=0
E2E_ADMIN_EMAIL=
E2E_ADMIN_PASSWORD=
